    {"name": "an activeTab past every integer is clamped to the last sheet", "file": "active-huge.xlsx", "options": {}, "activeSheet": {"index": 2, "name": "Third"}},
    {"name": "a non-numeric activeTab is the first sheet", "file": "active-junk.xlsx", "options": {}, "activeSheet": {"index": 0, "name": "First"}},
    {"name": "a negative activeTab is the first sheet", "file": "active-negative.xlsx", "options": {}, "activeSheet": {"index": 0, "name": "First"}},
    {"name": "whitespace around activeTab is collapsed", "file": "active-padded.xlsx", "options": {}, "activeSheet": {"index": 1, "name": "Second"}},
    {"name": "the first workbookView decides", "file": "two-book-views.xlsx", "options": {}, "activeSheet": {"index": 2, "name": "Third"}},
    {"name": "a sheet option leaves activeSheet out", "file": "active-1.xlsx", "options": {"sheet": "Second"}, "activeSheet": null},
    {"name": "a sheet option leaves it out even for the active sheet's neighbour", "file": "active-1.xlsx", "options": {"sheet": "First"}, "activeSheet": null},
    {"name": "an ods reads the view's ActiveTable", "file": "active-third.ods", "options": {}, "activeSheet": {"index": 2, "name": "Third"}},
    {"name": "an ods without settings.xml is the first table", "file": "no-settings.ods", "options": {}, "activeSheet": {"index": 0, "name": "First"}},
