    {"name": "activeTab names the sheet", "file": "active-1.xlsx", "options": {}, "activeSheet": {"index": 1, "name": "Second"}},
    {"name": "firstSheet does not decide", "file": "active-2.xlsx", "options": {}, "activeSheet": {"index": 2, "name": "Third"}},
